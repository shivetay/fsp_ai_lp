# --- Formularz kontaktowy ---------------------------------------------
# Opcja A: Formspree (bez backendu). Wpisz ID formularza z formspree.io/f/<ID>.
# Gdy ustawione, formularz wysyła dane bezpośrednio do Formspree.
NEXT_PUBLIC_FORMSPREE_ID=

# Opcja B: własny endpoint /api/contact + Resend (resend.com).
# Używane, gdy NEXT_PUBLIC_FORMSPREE_ID jest puste.
RESEND_API_KEY=
# Kilka odbiorców: rozdziel przecinkiem.
CONTACT_TO_EMAIL=kontakt@fsplukaszdawidowicz.pl
# Nadawca musi być z domeny zweryfikowanej w Resend.
CONTACT_FROM_EMAIL="Formularz FSP <formularz@fsplukaszdawidowicz.pl>"

# --- Demo ------------------------------------------------------------
# Adres demo do osadzenia w iframe (np. Streamlit, Gradio, Vercel, n8n form).
# Puste = pokazuje się wbudowane demo z src/demos.
NEXT_PUBLIC_DEMO_URL=

# --- SEO -------------------------------------------------------------
# Docelowy adres strony (canonical, sitemap, Open Graph). Bez "/" na końcu.
NEXT_PUBLIC_SITE_URL=https://www.fsplukaszdawidowicz.pl
# Kod weryfikacyjny z Google Search Console (metoda: tag HTML), opcjonalnie.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Antyspam (opcjonalnie) -------------------------------------------
# Cloudflare Turnstile: darmowa, niewidzialna captcha (dash.cloudflare.com, Turnstile, Add site).
# Bez tych kluczy formularz chroni honeypot, pułapka czasowa, limit zgłoszeń i filtr treści.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
